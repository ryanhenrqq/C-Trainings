<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object id="window" class="GtkWindow">
    <property name="title">Grid</property>
    <child>
	    <object id="grid" class="GtkGrid">
		    <!-- por favor nao ligue a pessima organização
			nesse arquivo, estou descobrindo e me adaptando
			ao editor de texto neovim

			vai por mim, é bem confuso
		    -->
	<child>
		<object class="GtkLabel" id="top-lb">
 			<property name="label"
            			translatable="yes"
				context="button">KalcCalculator in C</property>
			<layout>
              			<property name="column">0</property>
				<property name="row">0</property>
				<property name="column-span">3</property>
           		</layout>	
		</object>
	</child>


        <child>
          <object id="btn1" class="GtkButton">
            <property name="label">1</property>
            <layout>
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object id="btn2" class="GtkButton">
            <property name="label">2</property>
            <layout>
              <property name="column">1</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object id="btn3" class="GtkButton">
            <property name="label">3</property>
            <layout>
              <property name="column">2</property>
              <property name="row">1</property>
            </layout>
          </object>
  	</child>

        <child>
          <object id="btn4" class="GtkButton">
            <property name="label">4</property>
            <layout>
              <property name="column">0</property>
              <property name="row">2</property>
            </layout>
          </object>
  	</child>

	<child>
          <object id="btn5" class="GtkButton">
            <property name="label">5</property>
            <layout>
              <property name="column">1</property>
              <property name="row">2</property>
            </layout>
          </object>
  	</child>

	<child>
          <object id="btn6" class="GtkButton">
            <property name="label">6</property>
            <layout>
              <property name="column">2</property>
              <property name="row">2</property>
            </layout>
          </object>
  	</child>

        <child>
          <object id="btn7" class="GtkButton">
            <property name="label">7</property>
            <layout>
              <property name="column">0</property>
	      <property name="row">3</property>
            </layout>
          </object>
  	</child>

	<child>
          <object id="btn8" class="GtkButton">
            <property name="label">8</property>
            <layout>
              <property name="column">1</property>
              <property name="row">3</property>
            </layout>
          </object>
  	</child>

	<child>
          <object id="btn9" class="GtkButton">
            <property name="label">9</property>
            <layout>
              <property name="column">2</property>
              <property name="row">3</property>
            </layout>
          </object>
  	</child>

	<child>
          <object id="btn0" class="GtkButton">
            <property name="label">0</property>
            <layout>
              <property name="column">0</property>
              <property name="row">4</property>
            </layout>
          </object>
  	</child>
	<child>
          <object id="exit" class="GtkButton">
            <property name="label">sair</property>
            <layout>
              <property name="column">1</property>
              <property name="row">4</property>
              <property name="column-span">2</property>
            </layout>
          </object>
        </child>
	
      </object>
    </child>
  </object>
</interface>
